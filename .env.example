# Firebase Configuration
# Copy this file to .env and fill in your Firebase project values.
# Get these from Firebase Console → Project Settings → General → Your Apps → Web App

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Configuration
# Base URL for QR code generation — set to your deployed URL in production
VITE_APP_URL=http://localhost:5173

# Cloudinary Settings for Image Uploads (Menu items, logo, etc.)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# Firebase App Check (reCAPTCHA v3 site key, optional for local dev, required for production protection)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here
